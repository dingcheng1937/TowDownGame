[sub_resource type="GDScript" id="GDScript_anchor"]
script/source = "extends Node2D

func _physics_process(_delta: float) -> void:
	if Utils.player:
		var target = Utils.player.global_position
		var x = int(lerp(global_position.x, target.x, 0.2))
		var y = int(lerp(global_position.y, target.y, 0.2))
		global_position = Vector2(x, y)
"

[node name="UIWeaponListDemo" type="Node2D"]
script = ExtResource("1_starter")

[node name="PlayerRoot" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Hero" parent="PlayerRoot" instance=ExtResource("2_hero")]
position = Vector2(400, 300)

[node name="Anchor" type="Node2D" parent="PlayerRoot"]
