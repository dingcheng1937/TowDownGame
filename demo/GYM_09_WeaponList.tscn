[node name="Camera2D" type="Camera2D" parent="PlayerRoot/Anchor"]
zoom = Vector2(0.9, 0.9)
position_smoothing_enabled = true
script = ExtResource("3_camera")

[node name="Background" type="ColorRect" parent="."]
z_index = -1
offset_right = 800.0
