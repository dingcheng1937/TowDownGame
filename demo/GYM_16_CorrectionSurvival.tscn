[gd_scene format=3]

[ext_resource type="Script" path="res://demo/GYM_16_CorrectionSurvivalStarter.gd" id="1_starter"]
[ext_resource type="Script" uid="uid://c7oibv06cluva" path="res://game/hero/Camera2D.gd" id="3_camera"]

[sub_resource type="GDScript" id="GDScript_anchor"]
script/source = "extends Node2D

func _ready() -> void:
	# 立即跳转到玩家位置
	if PlayerServer.player_scene:
		global_position = PlayerServer.player_scene.global_position

func _physics_process(_delta: float) -> void:
	if PlayerServer.player_scene:
		var target = PlayerServer.player_scene.global_position
		var x = round(lerp(global_position.x, target.x, 0.2))
		var y = round(lerp(global_position.y, target.y, 0.2))
		global_position = Vector2(x, y)
"

[node name="CorrectionSurvival" type="Node2D"]
script = ExtResource("1_starter")

[node name="Anchor" type="Node2D" parent="."]
script = SubResource("GDScript_anchor")

